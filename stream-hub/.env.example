# Login credentials (baked at build time for static PWA).
# For production, prefer a backend auth API instead of client-side secrets.
VITE_APP_USERNAME=admin
VITE_APP_PASSWORD=changeme

# Optional: webhook when a customer installs the APK (Telegram/Zapier/Make).
# VITE_PROVISION_WEBHOOK=https://hooks.zapier.com/hooks/catch/xxxxx/yyyyy/

# Remote activation API (required for device-ID licensing).
# VITE_ACTIVATION_API=https://your-domain.com/api/max

# IPTV API (browser + app) — point to Next.js /api/max/iptv
# VITE_IPTV_API=https://your-domain.com/api/max/iptv

# Public player URL (optional — for generating customer links client-side)
# VITE_PLAYER_PUBLIC_URL=https://max.yourdomain.com
