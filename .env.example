# Platform OpenArt account (server-side). Generations run through this MCP account.
OPENART_ACCESS_TOKEN=
OPENART_MCP_URL=https://mcp.openart.ai/mcp

# Session / encryption secret for customer auth + owner credential store
AUTH_SECRET=replace-with-a-long-random-string

# Public app URL (Google OAuth redirect + Stripe redirects + owner OAuth)
# Production is locked to the brand domain (do not use *.trycloudflare.com):
#   APP_BASE_URL=https://veronix.ai
# Local:
APP_BASE_URL=http://localhost:3000

# Optional owner-only OpenArt OAuth setup gate
# OWNER_SETUP_KEY=

# --- Google Sign-In (customer first-time registration) ---
# Create OAuth Client ID (Web) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly:
#   {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe monthly subscriptions ---
# Dashboard: https://dashboard.stripe.com
# 1) STRIPE_SECRET_KEY = sk_test_... (test) or sk_live_...
# 2) Webhook endpoint: POST {APP_BASE_URL}/api/billing/webhook
#    Events: checkout.session.completed, invoice.paid
# 3) STRIPE_WEBHOOK_SECRET = whsec_...
# If unset, /api/billing/checkout uses demo activation (grants credits for testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed Stripe Price IDs; otherwise Checkout uses price_data
STRIPE_PRICE_MINI=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
