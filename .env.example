# REQUIRED: Google Gemini API key (platform account).
# All customer generations bill THIS account — customers never log in.
GEMINI_API_KEY=

# Optional override for Gemini video model (default: gemini-omni-flash-preview)
# GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# Optional override for Gemini image model (default: gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Public app origin (optional, used for absolute media URLs)
APP_BASE_URL=http://localhost:3000
