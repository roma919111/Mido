# --- BytePlus ModelArk (required for VYRONIX video + image) ---
# Console: https://console.byteplus.com → ModelArk → API Key Management
# Use the ARK API Key (Bearer) — NOT keys starting with "apikey-" from other products.
# Activate models: dreamina-seedance-2-0-mini-260615 (VYRONIX) and/or dreamina-seedance-2-0-260128 (Seedance 2.0)
BYTEPLUS_API_KEY=
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_VIDEO_MODEL=dreamina-seedance-2-0-mini-260615
# Optional — separate key for Seedance 2.0 full model (falls back to BYTEPLUS_API_KEY if unset):
# BYTEPLUS_SEEDANCE_2_API_KEY=
# BYTEPLUS_SEEDANCE_2_MODEL=dreamina-seedance-2-0-260128
# Optional image model override (Seedream):
# BYTEPLUS_IMAGE_MODEL=

# Optional vision for prompt enhance (entity matching from uploaded images).
# OpenAI-compatible (OpenAI / OpenRouter / etc.):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini
# Or Google Gemini (vision + Omni Flash video):
# GEMINI_API_KEY=
# GEMINI_AUDIO_MODEL=gemini-3.5-flash
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-flash-lite-latest
# (gemini-2.0-flash is retired — auto-mapped to gemini-2.5-flash if set)
# GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# MiniMax H3 video (platform.minimax.io):
# MINIMAX_API_KEY=
# MINIMAX_API_BASE_URL=https://api.minimax.io

# Kling 3.0 Omni video (kling.ai API):
# KLING_API_KEY=
# KLING_API_BASE_URL=https://api-singapore.klingai.com

# Black Forest Labs FLUX 3 video (official BFL — key starts with bfl_):
# Console: https://api.bfl.ai  ·  header: x-key
# BFL_API_KEY=
# BFL_API_BASE_URL=https://api.bfl.ai

# Session / encryption secret for customer auth + credential stores
AUTH_SECRET=replace-with-a-long-random-string

# Public app URL (Google OAuth redirect + Stripe redirects)
# Free branded preview (before buying a domain):
#   APP_BASE_URL=https://vyronix-ai.loca.lt
#   npm run tunnel:vyronix
# Permanent production domain:
APP_BASE_URL=https://vyronix.app

# Europe media-player replica only (never set this on the Singapore studio service):
# VYRONIX_SURFACE=player
# STUDIO_ORIGIN=https://mido-production-5cd6.up.railway.app
#
# Studio service: send IPTV video bytes to the Europe replica (page stays on vyronix.app):
# PLAYER_ORIGIN=https://maxmedia-production.up.railway.app

# Optional owner-only setup gate for /setup/*
# OWNER_SETUP_KEY=

# --- Google Sign-In (customer first-time registration) ---
# Create OAuth Client ID (Web) in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly:
#   {APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe monthly subscriptions ---
# Dashboard: https://dashboard.stripe.com
# 1) STRIPE_SECRET_KEY = sk_test_... (test) or sk_live_...
# 2) Webhook endpoint: POST {APP_BASE_URL}/api/billing/webhook
#    Events: checkout.session.completed, invoice.paid
# 3) STRIPE_WEBHOOK_SECRET = whsec_...
# If unset, /api/billing/checkout uses demo activation (grants credits for testing).
# Required for paid upgrades/top-ups. Without these, checkout refuses (no free credits).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed Stripe Price IDs; otherwise Checkout uses price_data
STRIPE_PRICE_MINI=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=

# Optional AdSense on /player only (leave empty unless the conversion page is approved)
# NEXT_PUBLIC_ADSENSE_CLIENT=
# NEXT_PUBLIC_ADSENSE_SLOT=

# --- PixVerse direct API (optional test model beside VYRONIX) ---
PIXVERSE_API_KEY=
PIXVERSE_API_BASE_URL=https://app-api.pixverse.ai
PIXVERSE_VIDEO_MODEL=v6

# --- Growth & analytics (optional) ---
# Google Analytics 4 — Measurement ID from GA4 property
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-YPEX7DHPY0
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
# Referral signup bonuses (wallet credits)
REFERRAL_SIGNUP_CREDITS_REFERRER=500
REFERRAL_SIGNUP_CREDITS_REFEREE=200

# TMDB (optional — live trending movies/series on /inspire)
# TMDB_API_KEY=

# --- Server load (keep Railway lean — defaults are light) ---
# SERVER_FFMPEG=0          # disable server ffmpeg entirely (transcribe must use client audio)
# SYNC_HEAVY=1             # enable full sync pipeline (stitch + recover + post-process)
# SYNC_AUTO_STITCH=1       # auto-stitch multi-shot on sync
# SYNC_AUTO_RECOVER=1      # recover provider clips on sync
# SYNC_POST_PROCESS=1      # outro + clarity during sync
