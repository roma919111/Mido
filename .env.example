# Bearer token from your OpenArt MCP OAuth session.
# Connect https://mcp.openart.ai/mcp in an MCP client, then paste the access token here.
OPENART_ACCESS_TOKEN=

# Optional override (defaults to https://mcp.openart.ai/mcp)
OPENART_MCP_URL=https://mcp.openart.ai/mcp

# Without OPENART_ACCESS_TOKEN the app uses demo media + 10 free local credits.
