# REQUIRED for production: owner OpenArt bearer token (platform account).
# All customer generations bill THIS account via MCP — customers never log in.
OPENART_ACCESS_TOKEN=

# Optional override (defaults to https://mcp.openart.ai/mcp)
OPENART_MCP_URL=https://mcp.openart.ai/mcp

# Encrypts the optional owner OAuth credential file (.data/openart-owner.enc)
AUTH_SECRET=replace-with-a-long-random-string

# Google Gemini API key for Gemini Omni Flash video generation
GEMINI_API_KEY=

# Optional override for Gemini video model (default: gemini-omni-flash-preview)
# GEMINI_VIDEO_MODEL=gemini-omni-flash-preview

# Public app origin (only needed if using one-time owner OAuth setup)
APP_BASE_URL=http://localhost:3000

# Optional secret for owner-only setup routes (/api/auth/login?key=...)
# OWNER_SETUP_KEY=choose-a-long-secret
