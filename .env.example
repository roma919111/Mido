# Encrypts the OpenArt OAuth session cookie (required in production).
AUTH_SECRET=replace-with-a-long-random-string

# Public app origin used for OAuth redirect_uri registration.
# Example local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Optional override (defaults to https://mcp.openart.ai/mcp)
OPENART_MCP_URL=https://mcp.openart.ai/mcp

# Optional static fallback token for headless/automation use.
# Prefer Sign in with OpenArt OAuth in the UI instead.
# OPENART_ACCESS_TOKEN=
