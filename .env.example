# Platform OpenArt account (server-side). Generations run through this MCP account.
OPENART_ACCESS_TOKEN=
OPENART_MCP_URL=https://mcp.openart.ai/mcp

# Session / encryption secret for customer auth + owner credential store
AUTH_SECRET=replace-with-a-long-random-string

# Public app URL (Stripe redirects + owner OAuth setup)
APP_BASE_URL=http://localhost:3000

# Optional owner-only OpenArt OAuth setup gate
# OWNER_SETUP_KEY=

# Stripe (monthly subscriptions). If unset, /api/billing/checkout uses demo activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed Stripe Price IDs; otherwise Checkout uses price_data
STRIPE_PRICE_MINI=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
